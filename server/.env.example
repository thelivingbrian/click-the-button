# Run from server/. Copy this file to .env for local development.
PORT=8080
HOST=127.0.0.1
PPROF_ENABLED=false
PPROF_PORT=6060
# Legacy-only intervals; the new station commits every accepted interaction.
SNAPSHOT_INTERVAL=2s
BROADCAST_INTERVAL=1s

# Google sign-in (optional locally; required to enable accounts).
# Download a Web application client JSON from Google Auth Platform.
# Keep credentials under server/secrets/ (ignored by Git), with file mode 600.
PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_FILE=
# Alternative to a JSON file: set both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# This verified Google email may claim the initial admin role once.
# Remove after the first successful administrator login; the role is persisted.
BOOTSTRAP_ADMIN_EMAIL=
# Production uses PUBLIC_BASE_URL=https://click-the-button.com and a distinct
# production client authorizing https://click-the-button.com/auth/google/callback.
